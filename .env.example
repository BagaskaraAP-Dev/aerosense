# Salin file ini menjadi .env.local lalu isi key yang kamu punya. Semuanya opsional:
# tanpa key apa pun AeroSense tetap jalan penuh (cuaca realtime + AI kamera di perangkat).

# Data udara TERUKUR dari stasiun darat (mis. BMKG Talang Betutu, Palembang) lewat jaringan WAQI.
# Tanpa token ini, AQI berasal dari model satelit CAMS (± 40 km) yang bisa meleset jauh saat kabut asap.
# Token gratis: https://aqicn.org/data-platform/token (isi email, token dikirim langsung).
WAQI_TOKEN=

# AI untuk saran teks dan "pendapat kedua" foto masker. Pilih salah satu (atau kosongkan keduanya:
# saran tetap muncul dari aturan lokal). Kalau keduanya terisi, Gemini yang dipakai.
#
# Gemini (Google) — ada paket gratis berkuota. Ambil key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional: ganti model tanpa mengubah kode. Bawaan: gemini-3.5-flash-lite
GEMINI_MODEL=
#
# Claude (Anthropic) — berbayar. Ambil key di https://platform.claude.com
ANTHROPIC_API_KEY=
# Opsional: paksa penyedia saat dua key terisi (gemini atau claude)
AI_PROVIDER=
